# Keep the repository's existing six-file publishing scope.
# Everything else stays local: .env, .venv, logs, state, backups, manuals,
# tests, editor settings, and agent notes/configuration.
/*

!/.gitignore
!/README.md
!/requirements.txt
!/matcha_multi_monitor.py
!/matcha_multi_monitor.env.example

# Allow only the existing GitHub Actions workflow inside .github.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/matcha.yml
