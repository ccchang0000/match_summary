# Publish monitor source, regression tests, and the repair report.
# Everything else stays local: .env, .venv, logs, state, backups, manual PDFs,
# editor settings, and agent notes/configuration.
/*

!/.gitignore
!/README.md
!/requirements.txt
!/matcha_multi_monitor.py
!/matcha_multi_monitor.env.example
!/MONITOR_REPAIR_REPORT.md
!/matcha_multi_monitor_manual.md
!/tests/
/tests/*
!/tests/test_*.py

# Allow only the existing GitHub Actions workflow inside .github.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/matcha.yml
